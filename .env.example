# UniTransit Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# ==========================================
# Application & Django Settings
# ==========================================
DEBUG=True
SECRET_KEY=unitransit-dev-insecure-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Database (PostgreSQL + PostGIS)
# ==========================================
POSTGRES_DB=unitransit
POSTGRES_USER=unitransit
POSTGRES_PASSWORD=unitransit_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Redis & Message Broker
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_KEY=transport.events
REDIS_GROUP_NAME=unitransit_consumers

# ==========================================
# Real-Time & Simulator Settings
# ==========================================
SIMULATOR_VEHICLES_COUNT=25
SIMULATOR_UPDATE_INTERVAL_SEC=2.0
SIMULATOR_FAULT_RATE=0.02
SIMULATOR_MODE=bus

# ==========================================
# Observability (Prometheus / Grafana)
# ==========================================
PROMETHEUS_METRICS_PORT=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==========================================
# Ports Configuration (Local Dev)
# ==========================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
