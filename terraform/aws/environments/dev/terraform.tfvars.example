# ==============================================================================
# AWS Dev Environment Configuration Example (Declarative Model)
# ==============================================================================

aws_region   = "us-east-1"
environment  = "dev"
vpc_cidr     = "10.0.0.0/16"
cluster_name = "unitransit-dev-eks"

# Sensitive Credentials (Placeholders — Inject via Environment Variables or AWS Secrets Manager)
db_password       = "CHANGE_ME_DEV_DB_PASSWORD"
django_secret_key = "CHANGE_ME_DEV_DJANGO_SECRET_KEY"

# Image Tags
backend_image  = "ghcr.io/reguveeran/unitransit-backend:8916745"
worker_image   = "ghcr.io/reguveeran/unitransit-worker:8916745"
frontend_image = "ghcr.io/reguveeran/unitransit-frontend:8916745"

# Ingress & Edge Configuration (Disabled by default)
enable_ingress = true
enable_tls     = false
enable_dns     = false
domain_name    = ""
hosted_zone_id = ""
